  "components": [
    {
      "name": "Filled action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Browser approximation of the native 64dp Material control with the pinned Tabler play glyph. Native ripple/focus and font scaling remain Android-owned.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 4v16l13 -8l-13 -8\" /></svg><span>Start run</span></button>",
      "css": ".ds-primary{display:flex;align-items:center;justify-content:center;gap:12px;background:#171717;color:#FFFFFF;border:0;border-radius:16px;padding:12px 16px;min-height:64px;width:100%;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-primary svg{width:24px;height:24px}.ds-primary:hover{background:#333333}.ds-primary:focus-visible{outline:3px solid #777777;outline-offset:3px}.ds-primary:active{background:#444444}"
    },
    {
      "name": "Outlined action",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Secondary Finish action shown below Resume when paused. Example browser interaction overlays are illustrative, not additional app tokens.",
      "html": "<button class=\"ds-outlined\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 7a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2l0 -10\" /></svg><span>Finish</span></button>",
      "css": ".ds-outlined{display:flex;align-items:center;justify-content:center;gap:12px;background:#FAFAFA;color:#171717;border:1px solid #777777;border-radius:16px;padding:12px 16px;min-height:64px;width:100%;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-outlined svg{width:24px;height:24px}.ds-outlined:hover{background:#EEEEEE}.ds-outlined:focus-visible{outline:3px solid #171717;outline-offset:3px}.ds-outlined:active{background:#E7E7E7}"
    },
    {
      "name": "Record and Runs tabs",
      "kind": "nav",
      "refersTo": "navigation-tabs",
      "description": "Two native tabs with Tabler icons and persistent short labels. Preview indicates selection but does not navigate.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Runline\"><button class=\"ds-tab ds-selected\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11.007 5a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\" /><path d=\"M4 17l5 1l.75 -1.5\" /><path d=\"M15 21v-4l-4 -3l1 -6\" /><path d=\"M7 12v-3l5 -1l3 3l3 1\" /></svg>Record</button><button class=\"ds-tab\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 8l0 4l2 2\" /><path d=\"M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5\" /></svg>Runs</button></nav>",
      "css": ".ds-tabs{display:flex;min-height:48px;background:#FAFAFA}.ds-tab{position:relative;display:flex;justify-content:center;align-items:center;gap:8px;flex:1;border:0;background:transparent;color:#5C5C5C;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-tab svg{width:24px;height:24px}.ds-selected{color:#171717}.ds-selected:after{content:\"\";position:absolute;bottom:0;left:25%;right:25%;height:3px;background:#171717}.ds-tab:hover{background:#EEEEEE}.ds-tab:focus-visible{outline:2px solid #171717;outline-offset:-3px}.ds-tab:active{background:#E7E7E7}"
    },
    {
      "name": "Live distance",
      "kind": "custom",
      "refersTo": "live-distance",
      "description": "Empty recording value and separate unit, showing the actual 56sp/24sp relationship at nominal browser scale.",
      "html": "<div class=\"ds-distance\"><span class=\"ds-number\">0.00</span><span class=\"ds-unit\">km</span></div>",
      "css": ".ds-distance{display:flex;align-items:baseline;background:#FAFAFA;color:#171717;font-family:Roboto,Arial,sans-serif}.ds-number{font-size:56px;font-weight:500;font-variant-numeric:tabular-nums}.ds-unit{margin-left:8px;font-size:24px;color:#5C5C5C}"
    },
    {
      "name": "Run row",
      "kind": "custom",
      "refersTo": "history-row",
      "description": "Flat whole-row native target; the example values are illustrative documentation content, not bundled user history.",
      "html": "<button class=\"ds-history\"><span class=\"ds-date\">Example run</span><span class=\"ds-history-distance\">5.00 km</span><span class=\"ds-summary\">30:00 active · 6:00 /km</span></button>",
      "css": ".ds-history{display:flex;flex-direction:column;text-align:left;width:100%;min-height:80px;background:#FAFAFA;border:0;border-bottom:1px solid #EEEEEE;padding:20px 4px;color:#171717;font-family:Roboto,Arial,sans-serif;cursor:pointer}.ds-date,.ds-summary{font-size:14px;color:#5C5C5C}.ds-history-distance{font-size:26px;font-weight:500;margin-top:6px}.ds-summary{margin-top:4px}.ds-history:hover{background:#EEEEEE}.ds-history:focus-visible{outline:2px solid #171717;outline-offset:-2px}.ds-history:active{background:#E7E7E7}"
    },
    {
      "name": "Route awaiting a fix",
      "kind": "custom",
      "refersTo": "route-trace",
      "description": "A session can show this state while acquiring GPS. The idle Ready screen omits the panel. Populated routes draw actual samples, never illustrative geometry.",
      "html": "<div class=\"ds-route\" role=\"img\" aria-label=\"Waiting for recorded GPS points\">Finding GPS…</div>",
      "css": ".ds-route{height:180px;display:flex;align-items:center;justify-content:center;background:#EEEEEE;color:#5C5C5C;font:400 14px Roboto,Arial,sans-serif}"
    },
    {
      "name": "Split row",
      "kind": "custom",
      "refersTo": "detail-row",
      "description": "A compact ruled row with equal columns, muted label and end-aligned value. This example has no measured data.",
      "html": "<div class=\"ds-detail\"><span class=\"ds-detail-label\">Km 1</span><span class=\"ds-detail-value\">— /km</span></div>",
      "css": ".ds-detail{display:flex;align-items:center;background:#FAFAFA;border-bottom:1px solid #EEEEEE;padding:12px 0;font-family:Roboto,Arial,sans-serif}.ds-detail-label{flex:1;color:#5C5C5C;font-size:15px}.ds-detail-value{flex:1;text-align:right;color:#171717;font-size:16px;font-weight:500}"
    }
  ],
  "narrative": {
    "northStar": "Minimal running instrument",
    "overview": "The user requested monotone colors, very little text, simple controls and one sporty free icon set. Runline now uses neutral day/night roles, the Tabler outline family and short status/action labels. Distance, time and pace lead; occasional details move to menus. Runline remains a working name.",
    "keyCharacteristics": [
      "Achromatic day/night role colors.",
      "One Tabler outline family with short action labels.",
      "Large real measurements and explicit recording states.",
      "Native Material controls, flat lists and route traces."
    ],
    "rules": [
      {
        "name": "Paired neutral roles",
        "body": "Keep foreground and background within the same active day/night scheme; no hue accents are added.",
        "section": "colors"
      },
      {
        "name": "Short labels, honest states",
        "body": "Move explanations into Run info or protection help, but preserve visible errors, GPS uncertainty and recovery actions.",
        "section": "typography"
      }
    ],
    "dos": [
      "Use only the pinned Tabler outline icons for app pictograms.",
      "Keep Start/Pause/Resume/Finish labeled and easy to reach.",
      "Use explicit state words, not color alone.",
      "Preserve native font scaling and accessible names.",
      "Keep sharing status honest: a saved file or opened browser is not an upload."
    ],
    "donts": [
      "Do not reintroduce the green prototype palette or promotional headings.",
      "Do not replace important labels with ambiguous icons.",
      "Do not add decorative maps, charts or invented sensor values.",
      "Do not turn every row into an elevated card.",
      "Do not treat browser previews or synthesized neutral ramps as extra native tokens."
    ]
  }
}
