  "components": [
    {
      "name": "Filled action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Browser approximation of the native 64dp Material control with the pinned Tabler play glyph. Native ripple/focus and font scaling remain Android-owned.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 4v16l13 -8l-13 -8\" /></svg><span>Start run</span></button>",
      "css": ".ds-primary{display:flex;align-items:center;justify-content:center;gap:12px;background:#171717;color:#FFFFFF;border:0;border-radius:16px;padding:12px 16px;min-height:64px;width:100%;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-primary svg{width:24px;height:24px}.ds-primary:hover{background:#333333}.ds-primary:focus-visible{outline:3px solid #777777;outline-offset:3px}.ds-primary:active{background:#444444}"
    },
    {
      "name": "Outlined action",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Secondary Finish action shown below Resume when paused. Example browser interaction overlays are illustrative, not additional app tokens.",
      "html": "<button class=\"ds-outlined\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 7a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2l0 -10\" /></svg><span>Finish</span></button>",
      "css": ".ds-outlined{display:flex;align-items:center;justify-content:center;gap:12px;background:#FAFAFA;color:#171717;border:1px solid #777777;border-radius:16px;padding:12px 16px;min-height:64px;width:100%;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-outlined svg{width:24px;height:24px}.ds-outlined:hover{background:#EEEEEE}.ds-outlined:focus-visible{outline:3px solid #171717;outline-offset:3px}.ds-outlined:active{background:#E7E7E7}"
    },
    {
      "name": "Record and Runs tabs",
      "kind": "nav",
      "refersTo": "navigation-tabs",
      "description": "Two native tabs with Tabler icons and persistent short labels. Preview indicates selection but does not navigate.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Runline\"><button class=\"ds-tab ds-selected\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11.007 5a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\" /><path d=\"M4 17l5 1l.75 -1.5\" /><path d=\"M15 21v-4l-4 -3l1 -6\" /><path d=\"M7 12v-3l5 -1l3 3l3 1\" /></svg>Record</button><button class=\"ds-tab\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 8l0 4l2 2\" /><path d=\"M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5\" /></svg>Runs</button></nav>",
      "css": ".ds-tabs{display:flex;min-height:48px;background:#FAFAFA}.ds-tab{position:relative;display:flex;justify-content:center;align-items:center;gap:8px;flex:1;border:0;background:transparent;color:#5C5C5C;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-tab svg{width:24px;height:24px}.ds-selected{color:#171717}.ds-selected:after{content:\"\";position:absolute;bottom:0;left:25%;right:25%;height:3px;background:#171717}.ds-tab:hover{background:#EEEEEE}.ds-tab:focus-visible{outline:2px solid #171717;outline-offset:-3px}.ds-tab:active{background:#E7E7E7}"
    },
    {
      "name": "Live distance",
      "kind": "custom",
      "refersTo": "live-distance",
      "description": "Empty recording value with the native 40sp/24sp size relationship at nominal browser scale.",
      "html": "<div class=\"ds-distance\"><span class=\"ds-number\">0.00</span><span class=\"ds-unit\">km</span></div>",
      "css": ".ds-distance{display:flex;align-items:baseline;background:#FAFAFA;color:#171717;font-family:Roboto,Arial,sans-serif}.ds-number{font-size:40px;font-weight:500;font-variant-numeric:tabular-nums}.ds-unit{margin-left:8px;font-size:24px;color:#5C5C5C}"
    },
    {
      "name": "Run row",
      "kind": "custom",
      "refersTo": "history-row",
      "description": "Flat whole-row native target; the example values are illustrative documentation content, not bundled user history.",
      "html": "<button class=\"ds-history\"><span class=\"ds-date\">Example run</span><span class=\"ds-history-distance\">5.00 km</span><span class=\"ds-summary\">30:00 active · 6:00 /km</span></button>",
      "css": ".ds-history{display:flex;flex-direction:column;text-align:left;width:100%;min-height:80px;background:#FAFAFA;border:0;border-bottom:1px solid #EEEEEE;padding:20px 4px;color:#171717;font-family:Roboto,Arial,sans-serif;cursor:pointer}.ds-date,.ds-summary{font-size:14px;color:#5C5C5C}.ds-history-distance{font-size:26px;font-weight:500;margin-top:6px}.ds-summary{margin-top:4px}.ds-history:hover{background:#EEEEEE}.ds-history:focus-visible{outline:2px solid #171717;outline-offset:-2px}.ds-history:active{background:#E7E7E7}"
    },
    {
      "name": "Satellite map shell",
      "kind": "custom",
      "refersTo": "satellite-map",
      "description": "A 240dp ready/live map with fit/follow and 48dp credit controls. Below 500dp screen height, it becomes 120dp; saved-run replay maps use 300dp or 160dp. This neutral documentation placeholder contains no imagery or invented route. Runtime imagery retains real colors.",
      "html": "<div class=\"ds-map\"><span class=\"ds-map-placeholder\">Satellite imagery</span><div class=\"ds-map-controls\"><button aria-label=\"Fit entire route\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0\" /><path d=\"M19 7a2 2 0 1 0 0 -4a2 2 0 0 0 0 4\" /><path d=\"M11 19h5.5a3.5 3.5 0 0 0 0 -7h-8a3.5 3.5 0 0 1 0 -7h4.5\" /></svg></button><button aria-label=\"Follow moving marker\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0\" /><path d=\"M4 12a8 8 0 1 0 16 0a8 8 0 1 0 -16 0\" /><path d=\"M12 2l0 2\" /><path d=\"M12 20l0 2\" /><path d=\"M20 12l2 0\" /><path d=\"M2 12l2 0\" /></svg></button></div><button class=\"ds-map-credits\">© IGN · EOX · OpenStreetMap</button></div>",
      "css": ".ds-map{position:relative;height:240px;background:#EEEEEE;color:#171717;font:400 14px Roboto,Arial,sans-serif}.ds-map-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#5C5C5C}.ds-map-controls{position:absolute;right:8px;top:8px;display:flex;flex-direction:column}.ds-map button{background:#FFFFFF;color:#171717;border:0;cursor:pointer}.ds-map-controls button{height:48px;width:48px}.ds-map svg{width:24px;height:24px}.ds-map-credits{position:absolute;left:0;bottom:0;min-height:48px;padding:0 8px;font-size:11px}.ds-map button:focus-visible{outline:2px solid #171717;outline-offset:-3px}.ds-map button:hover{background:#E7E7E7}"
    },
    {
      "name": "Split row",
      "kind": "custom",
      "refersTo": "detail-row",
      "description": "A compact ruled row with equal columns, muted label and end-aligned value. This example has no measured data.",
      "html": "<div class=\"ds-detail\"><span class=\"ds-detail-label\">Km 1</span><span class=\"ds-detail-value\">— /km</span></div>",
      "css": ".ds-detail{display:flex;align-items:center;background:#FAFAFA;border-bottom:1px solid #EEEEEE;padding:12px 0;font-family:Roboto,Arial,sans-serif}.ds-detail-label{flex:1;color:#5C5C5C;font-size:15px}.ds-detail-value{flex:1;text-align:right;color:#171717;font-size:16px;font-weight:500}"
    },
    {
      "name": "Replay controls",
      "kind": "custom",
      "refersTo": "replay-control",
      "description": "Outlined 52dp Play and speed controls with 20dp Tabler glyphs. Native speed choices are 1×, 5×, 10×, 30× and 60×; these documentation buttons do not play a route.",
      "html": "<div class=\"ds-replay\"><button><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 4v16l13 -8l-13 -8\" /></svg>Play</button><button aria-label=\"Playback speed, 30 times\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\" /><path d=\"M12 7v5l3 3\" /></svg>30×</button></div>",
      "css": ".ds-replay{display:flex;gap:8px;background:#FAFAFA}.ds-replay button{display:flex;flex:1;align-items:center;justify-content:center;gap:5px;min-height:52px;border:1px solid #777777;border-radius:12px;background:#FAFAFA;color:#171717;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-replay svg{width:20px;height:20px}.ds-replay button:hover{background:#EEEEEE}.ds-replay button:focus-visible{outline:2px solid #171717;outline-offset:2px}"
    },
    {
      "name": "Missing altitude",
      "kind": "custom",
      "refersTo": "altitude-profile",
      "description": "Native 144dp altitude panel when no altitude data exists. Measured profiles preserve missing-data and segment gaps; no sample chart is fabricated here.",
      "html": "<div class=\"ds-altitude\" role=\"img\" aria-label=\"No GPS altitude data\">No GPS altitude data</div>",
      "css": ".ds-altitude{height:144px;display:flex;align-items:center;justify-content:center;background:#FAFAFA;color:#5C5C5C;font:400 12px Roboto,Arial,sans-serif}"
    },
    {
      "name": "Strava toolbar action",
      "kind": "button",
      "refersTo": "toolbar-strava",
      "description": "A labeled 48dp toolbar action remains accessible above the saved run. It saves GPX and opens a browser; it does not connect or publish an account activity.",
      "html": "<button class=\"ds-strava\" aria-label=\"Share run to Strava\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2\" /><path d=\"M7 9l5 -5l5 5\" /><path d=\"M12 4l0 12\" /></svg>Strava</button>",
      "css": ".ds-strava{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:48px;padding:0 8px;border:0;background:#FAFAFA;color:#171717;font:500 14px Roboto,Arial,sans-serif;cursor:pointer}.ds-strava svg{width:20px;height:20px}.ds-strava:hover{background:#EEEEEE}.ds-strava:focus-visible{outline:2px solid #171717;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Minimal running instrument",
    "overview": "Version 0.3 keeps the user-pinned monotone controls, few words and one Tabler outline family while adding real satellite imagery, GPS replay and more measurements. Satellite images retain their colors. Recording/replay maps are 240dp/300dp, or 120dp/160dp below 500dp screen height; Strava stays in the toolbar. API 34 emulator review covered imagery, playback, light/dark, 1.3× font scale and landscape. The final sharing dialog was confirmed monochrome and the map-credit target measured 48dp; physical-phone coverage remains unverified.",
    "keyCharacteristics": [
      "Achromatic controls in paired day/night roles; real-color map imagery.",
      "One Tabler outline family with short labels and accessible icon actions.",
      "Bottom recording actions and a visible Strava toolbar action.",
      "Observed GPS replay with explicit missing-data gaps and estimated measurements.",
      "Flat native lists and local route overlays, with visible map attribution."
    ],
    "rules": [
      {
        "name": "Neutral chrome, real imagery",
        "body": "Application controls retain neutral roles. Satellite/aerial tiles and supplied place labels preserve their source colors. Keep credits visible; do not add a brand accent.",
        "section": "colors"
      },
      {
        "name": "Short labels, honest states",
        "body": "Use — for missing measurements and expose useful errors. Put detailed calculation rules in Run info; keep replay time distinct from active time.",
        "section": "typography"
      },
      {
        "name": "Display is separate from capture",
        "body": "Maps request visible tiles, not raw run files. Offline background recording and recovery were checked on the API 34 emulator. Replay uses observed GPS intervals, pauses in the background and does not export video. This evidence does not certify every device or failure path.",
        "section": "components"
      }
    ],
    "dos": [
      "Use only the pinned Tabler outline icons for app pictograms.",
      "Keep Start/Pause/Resume/Finish labeled and easy to reach.",
