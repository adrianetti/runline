{
  "comments": {
    "suffixes": [
      ".kt",
      ".kts",
      ".java",
      ".gradle",
      ".py",
      ".xml",
      ".yml",
      ".yaml",
      ".toml",
      ".properties",
      ".pro"
    ],
    "exempt_paths": [
      "third_party/*",
      "tools/security/rules/*",
      "tools/trust/fixtures/*"
    ],
    "allowed": [
      {
        "path": ".github/*.yml",
        "pattern": "# v\\d+(\\.\\d+)*",
        "reason": "Dependabot reads the release tag written beside each commit-pinned action."
      },
      {
        "path": "app/src/main/res/drawable/ic_*.xml",
        "pattern": "<!-- Tabler Icons / [a-z0-9-]+; MIT; source revision [0-9a-f]{40}\\. Generated by tools/import_icons\\.py\\. -->",
        "reason": "Generated provenance header that tools/import_icons.py --check verifies byte for byte."
      }
    ]
  },
  "architecture": {
    "source_roots": [
      "app/src/main/java/com/runline/app"
    ],
    "package": "com.runline.app",
    "shared_classes": [
      "R",
      "BuildConfig"
    ],
    "pure_modules": [
      "core"
    ],
    "pure_forbidden_imports": [
      "android.",
      "androidx.",
      "com.google.",
      "org.maplibre.",
      "java.net.",
      "javax.net.",
      "com.runline.app.R",
      "com.runline.app.BuildConfig"
    ],
    "modules": {
      "core": [],
      "i18n": [],
      "training": [],
      "updates": [],
      "terrain": [
        "core"
      ],
      "data": [
        "core"
      ],
      "coaching": [
        "core",
        "i18n"
      ],
      "music": [
        "core",
        "terrain"
      ],
      "diagnostics": [
        "core"
      ],
      "ai": [
        "coaching",
        "core",
        "data",
        "diagnostics",
        "i18n",
        "terrain",
        "training"
      ],
      "sharing": [
        "ai",
        "core",
        "data",
        "diagnostics",
        "i18n",
        "terrain"
      ],
      "tracking": [
        "ai",
        "coaching",
        "core",
        "data",
        "diagnostics",
        "i18n",
        "music",
        "terrain"
      ],
      "ui": [
        "ai",
        "coaching",
        "core",
        "data",
        "diagnostics",
        "i18n",
        "music",
        "sharing",
        "terrain",
        "tracking",
        "training",
        "updates"
      ],
      "app": [
        "ai",
        "coaching",
        "core",
        "data",
        "diagnostics",
        "i18n",
        "music",
        "sharing",
        "terrain",
        "tracking",
        "training",
        "ui",
        "updates"
      ]
    }
  },
  "tests": {
    "kotlin_test_roots": [
      "app/src/test",
      "app/src/androidTest"
    ],
    "deterministic_roots": [
      "app/src/test"
    ],
    "python_test_glob": "tools/*/test_*.py",
    "forbidden_calls": [
      {
        "id": "sleep",
        "pattern": "\\bThread\\.sleep\\s*\\(",
        "reason": "Wall-clock waits make JVM tests slow and flaky; inject a clock or scheduler."
      },
      {
        "id": "wall-clock",
        "pattern": "\\bSystem\\s*\\.\\s*(currentTimeMillis|nanoTime)\\s*\\(",
        "reason": "Tests must pass a fixed time instead of reading the host clock."
      },
      {
        "id": "now",
        "pattern": "\\b(Instant|LocalDate|LocalDateTime|LocalTime|ZonedDateTime|OffsetDateTime|Clock)\\s*\\.\\s*(now|systemDefaultZone|systemUTC)\\s*\\(",
        "reason": "Tests must pass a fixed time instead of reading the host clock."
      },
      {
        "id": "unseeded-random",
        "pattern": "\\b(Math\\.random\\s*\\(|Random\\s*\\(\\s*\\)|Random\\.Default\\b|UUID\\.randomUUID\\s*\\()",
        "reason": "Randomness in tests must use a fixed seed."
      },
      {
        "id": "ignored-test",
        "pattern": "@Ignore\\b",
        "reason": "Disabled tests hide regressions; delete or fix the test."
      },
      {
        "id": "default-locale",
        "pattern": "\\bLocale\\.setDefault\\s*\\(",
        "reason": "Changing the JVM default locale leaks across tests; pass a Locale explicitly."
      }
    ]
  },
  "suppressions": {
    "patterns": [
      {
        "id": "kotlin-suppress",
        "suffixes": [
          ".kt",
          ".kts"
        ],
        "pattern": "@(?:file:)?Suppress(?:Lint|Warnings)?\\b"
      },
      {
        "id": "android-lint-ignore",
        "suffixes": [
          ".xml"
        ],
        "pattern": "tools:ignore\\s*="
      }
    ]
  },
  "gates": {
    "override_label": "gate-change",
    "protected_paths": [
      ".editorconfig",
      ".github/workflows/*",
      ".github/dependabot.yml",
      ".github/PULL_REQUEST_TEMPLATE.md",
      "AGENTS.md",
      "CLAUDE.md",
      "pyproject.toml",
      "config/detekt/detekt.yml",
      "config/trust/policy.json",
      "config/trust/toolchain.json",
      "gradle/wrapper/*",
      "tools/security/*",
      "tools/trust/*"
    ],
    "ratcheted_files": {
      "detekt": "config/detekt/baseline.xml",
      "lint": "app/lint-baseline.xml",
      "debt": "config/trust/debt.json",
      "coverage": "config/trust/coverage.json"
    },
    "required_settings": [
      {
        "path": "app/build.gradle.kts",
        "pattern": "abortOnError = true"
      },
      {
        "path": "app/build.gradle.kts",
        "pattern": "warningsAsErrors = true"
      },
      {
        "path": "app/build.gradle.kts",
        "pattern": "checkReleaseBuilds = true"
      },
      {
        "path": "app/build.gradle.kts",
        "pattern": "baseline = file\\(\"lint-baseline\\.xml\"\\)"
      },
      {
        "path": "app/build.gradle.kts",
        "pattern": "enableUnitTestCoverage = true"
      },
      {
        "path": "app/build.gradle.kts",
        "pattern": "checkAllWarnings = true"
      }
    ]
  }
}
